---
// Post card component for displaying blog posts
interface Props {
  slug: string;
  title: string;
  date: string;
  description?: string;
  complexity?: string;
  tags?: string[];
}

const { 
  slug, 
  title, 
  date = "2026-10-10", 
  description = "Deep architectural systems analysis with production code snippets and Mermaid diagrams.",
  complexity = "Advanced",
  tags = ["Architecture", "Cloud Native"]
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<article class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 transition shadow-xl flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
      <span class="text-cyan-400 font-bold">
        {complexity}
      </span>
      <span>{date}</span>
    </div>
    <h2 class="text-xl font-bold text-white group-hover:text-cyan-300 transition mb-2">
      <a href={`${baseUrl}blog/${slug}/`}>
        {title}
      </a>
    </h2>
    <p class="text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
      {description}
    </p>
  </div>
  <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
          {tag}
        </span>
      ))}
    </div>
    <a href={`${baseUrl}blog/${slug}/`} class="text-xs font-bold text-cyan-400 group-hover:translate-x-1 transition flex items-center gap-1">
      Read &rarr;
    </a>
  </div>
</article>
