---
// Header component with navigation
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "System Design & Architecture", subtitle = "Mayur Bakale • 14+ Years Cloud-Native & AI Systems" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <div>
      <a href={`${baseUrl}`} class="text-lg font-black tracking-tight text-white hover:text-cyan-400 transition flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
        {title}
      </a>
      <p class="text-xs text-slate-400 font-mono">{subtitle}</p>
    </div>
    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/mayurbakale-labs/deterministic-ai-pipeline" 
        target="_blank" 
        rel="noreferrer" 
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 underline"
      >
        GitHub Repository &rarr;
      </a>
    </div>
  </div>
</header>
