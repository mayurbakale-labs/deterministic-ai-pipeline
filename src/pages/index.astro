---
// Home page - Architecture & Engineering Index
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import Footer from '../components/Footer.astro';

let posts = [];
try {
  posts = (await getCollection('blog')).sort((a, b) => {
    const dateA = new Date(a.data?.publishDate || a.data?.date || '2026-01-01').getTime();
    const dateB = new Date(b.data?.publishDate || b.data?.date || '2026-01-01').getTime();
    return dateB - dateA;
  });
} catch (e) {
  posts = [];
}

const fallbackCatalog = [
  {
    "slug": "distributed-sagas-with-the-transactional-outbox-patt-eiva44ea",
    "title": "Distributed Sagas With The Transactional Outbox Patt Eiva44ea",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Distributed Sagas With The Transactional Outbox Patt Eiva44ea."
  },
  {
    "slug": "mcp-spring-java21-2026",
    "title": "Mcp Spring Java21 2026",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Mcp Spring Java21 2026."
  },
  {
    "slug": "model-context-protocol-enterprise-concurrency-d4e2",
    "title": "Model Context Protocol Enterprise Concurrency D4e2",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Model Context Protocol Enterprise Concurrency D4e2."
  }
];

const displayPosts = (posts && posts.length > 0)
  ? posts.map((post) => ({
      slug: post.slug || post.id,
      title: post.data?.title || post.slug,
      date: post.data?.publishDate ? String(post.data.publishDate).split('T')[0] : '2026-10-10',
      description: post.data?.description || '',
      complexity: post.data?.complexity || 'Advanced',
      tags: post.data?.tags || ['Architecture', 'Cloud Native']
    }))
  : fallbackCatalog.map(p => ({
      slug: p.slug,
      title: p.title,
      date: p.date,
      description: p.description,
      complexity: 'Advanced',
      tags: ['System Design', 'Enterprise']
    }));
---

<BaseLayout 
  title="System Design & Enterprise Architecture | Mayur Bakale"
  description="Deep architectural blueprints, production code implementations, and zero-trust engineering patterns."
>
  <Header />
  
  <main class="max-w-6xl mx-auto px-4 py-12 flex-grow">
    <!-- Hero Section -->
    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-3">
        Architecture & Engineering Index
      </h1>
      <p class="text-slate-400 text-sm sm:text-base max-w-2xl">
        Deep architectural blueprints, production code implementations (Java for System Design & Python for AI Agents), and zero-trust engineering patterns.
      </p>
    </div>

    <!-- Posts Directory Grid -->
    {displayPosts && displayPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {displayPosts.map((post) => (
          <PostCard 
            slug={post.slug}
            title={post.title}
            date={post.date}
            description={post.description}
            complexity={post.complexity}
            tags={post.tags}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800 text-center">
        <p class="text-slate-300 mb-3">Published articles are accessible via the blog directory.</p>
        <a href={`${import.meta.env.BASE_URL}blog/building-deterministic-ai-pipelines`} class="text-cyan-400 font-bold hover:underline text-sm">
          Read Featured Article &rarr;
        </a>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
