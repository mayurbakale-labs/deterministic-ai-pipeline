---
// Home page - lists all blog posts using the same layout/typography as the blog article pages
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';

let posts = [];
try {
  posts = (await getCollection('blog')).sort((a, b) => {
    const dateA = new Date(a.data?.publishDate || a.data?.date || '2026-01-01').getTime();
    const dateB = new Date(b.data?.publishDate || b.data?.date || '2026-01-01').getTime();
    return dateB - dateA;
  });
} catch (e) {
  posts = [];
}

const displayPosts = posts.map((post) => ({
  slug: post.id,
  title: post.data?.title || post.id,
  date: post.data?.publishDate ? post.data.publishDate.toISOString().split('T')[0] : '2026-10-10',
  description: post.data?.description,
  complexity: post.data?.complexity || 'Advanced',
  tags: post.data?.tags || ['Architecture', 'Cloud Native'],
}));
---

<BaseLayout 
  title="System Design & Enterprise Architecture | Mayur Bakale"
  description="Architecture blueprints, production code, and engineering patterns for full stack, cloud-native, and AI systems by Mayur Bakale."
>
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-8 w-full flex-grow">
    <h1 class="sr-only">System Design &amp; Enterprise Architecture Articles</h1>

    {displayPosts.length > 0 ? (
      <div>
        {displayPosts.map((post) => (
          <PostCard 
            slug={post.slug}
            title={post.title}
            date={post.date}
            description={post.description}
            complexity={post.complexity}
            tags={post.tags}
          />
        ))}
      </div>
    ) : (
      <p class="py-16 text-center text-slate-500">No articles have been published yet.</p>
    )}
  </main>
</BaseLayout>
