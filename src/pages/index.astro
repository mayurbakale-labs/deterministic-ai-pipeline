---
// Generated by Deterministic AI Technical Blog Pipeline
// Directory Index for Mayur Bakale Enterprise System Design & AI Systems Blog
import { getCollection } from 'astro:content';

let posts = [];
try {
  posts = (await getCollection('blog')).sort((a, b) => {
    const dateA = new Date(a.data?.publishDate || a.data?.date || '2026-01-01').getTime();
    const dateB = new Date(b.data?.publishDate || b.data?.date || '2026-01-01').getTime();
    return dateB - dateA;
  });
} catch (e) {
  posts = [];
}

const fallbackCatalog = [
  {
    "slug": "distributed-sagas-with-the-transactional-outbox-patt-eiva44ea",
    "title": "Distributed Sagas With The Transactional Outbox Patt Eiva44ea",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Distributed Sagas With The Transactional Outbox Patt Eiva44ea."
  },
  {
    "slug": "mcp-spring-java21-2026",
    "title": "Mcp Spring Java21 2026",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Mcp Spring Java21 2026."
  },
  {
    "slug": "model-context-protocol-enterprise-concurrency-d4e2",
    "title": "Model Context Protocol Enterprise Concurrency D4e2",
    "date": "2026-10-11",
    "description": "Enterprise architectural deep dive on Model Context Protocol Enterprise Concurrency D4e2."
  }
];
const displayPosts = (posts && posts.length > 0)
  ? posts.map((post) => ({
      slug: post.slug || post.id,
      title: post.data?.title || post.slug,
      date: post.data?.publishDate ? String(post.data.publishDate).split('T')[0] : '2026-10-10',
      description: post.data?.description || '',
      complexity: post.data?.complexity || 'Advanced',
      tags: post.data?.tags || ['Architecture', 'Cloud Native']
    }))
  : fallbackCatalog.map(p => ({
      slug: p.slug,
      title: p.title,
      date: p.date,
      description: p.description,
      complexity: 'Advanced',
      tags: ['System Design', 'Enterprise']
    }));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Design & Enterprise Architecture | Mayur Bakale</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen">
    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <div>
          <a href="/deterministic-ai-pipeline/" class="text-lg font-black tracking-tight text-white hover:text-cyan-400 transition flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            System Design &amp; Architecture
          </a>
          <p class="text-xs text-slate-400 font-mono">Mayur Bakale &bull; 14+ Years Cloud-Native &amp; AI Systems</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="https://github.com/mayurbakale-labs/deterministic-ai-pipeline" target="_blank" rel="noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 underline">
            GitHub Repository &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl mx-auto px-4 py-12">
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-3">
          Architecture &amp; Engineering Index
        </h1>
        <p class="text-slate-400 text-sm sm:text-base max-w-2xl">
          Deep architectural blueprints, production code implementations (Java for System Design &amp; Python for AI Agents), and zero-trust engineering patterns.
        </p>
      </div>

      <!-- Posts Directory Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {displayPosts && displayPosts.length > 0 ? (
          displayPosts.map((post) => (
            <article class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 transition shadow-xl flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
                  <span class="text-cyan-400 font-bold">
                    {post.complexity || 'Advanced'}
                  </span>
                  <span>{post.date || '2026-10-10'}</span>
                </div>
                <h2 class="text-xl font-bold text-white group-hover:text-cyan-300 transition mb-2">
                  <a href={`/deterministic-ai-pipeline/blog/${post.slug}/`}>
                    {post.title}
                  </a>
                </h2>
                <p class="text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {post.description || 'Deep architectural systems analysis with production code snippets and Mermaid diagrams.'}
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div class="flex flex-wrap gap-1.5">
                  {(post.tags || ['Architecture', 'Cloud Native']).slice(0, 3).map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={`/deterministic-ai-pipeline/blog/${post.slug}/`} class="text-xs font-bold text-cyan-400 group-hover:translate-x-1 transition flex items-center gap-1">
                  Read &rarr;
                </a>
              </div>
            </article>
          ))
        ) : (
          <div class="col-span-full p-8 rounded-2xl bg-slate-900 border border-slate-800 text-center">
            <p class="text-slate-300 mb-3">Published articles are accessible via the blog directory.</p>
            <a href="/deterministic-ai-pipeline/blog/building-deterministic-ai-pipelines" class="text-cyan-400 font-bold hover:underline text-sm">
              Read Featured Article &rarr;
            </a>
          </div>
        )}
      </div>
    </main>

    <footer class="border-t border-slate-900 py-8 text-center text-xs font-mono text-slate-500">
      <p>&copy; Mayur Bakale &bull; Deterministic AI Pipeline &bull; Cloud-Native Architecture</p>
    </footer>
  </body>
</html>
